{
  "name": "justfair",
  "version": "1.0.7",
  "description": "Financial-correctness crash testing for stock applications and market infrastructure on Solana",
  "main": "src/cli.js",
  "bin": {
    "justfair": "src/cli.js"
  },
  "files": [
    "src/",
    "docs/adapter.md",
    "examples/adapter-basic/",
    "public/",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Techkeyy/justfair.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node test/preflight.test.js",
    "test:e2e": "node test/e2e.test.js",
    "test:browser": "node test/browser.test.js",
    "check": "node src/cli.js check",
    "doctor": "node src/cli.js doctor",
    "start": "node src/server.js"
  },
  "keywords": [
    "solana",
    "tokenized-stocks",
    "financial-testing",
    "crash-testing",
    "token-2022",
    "meteora-dbc",
    "prestocks",
    "tessera"
  ],
  "author": "Techkeyy",
  "license": "MIT",
  "dependencies": {
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.12",
    "@solana/kit": "^8.3.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.5"
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "^11.1.1"
    },
    "jayson": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  },
  "bugs": {
    "url": "https://github.com/Techkeyy/justfair/issues"
  },
  "homepage": "https://github.com/Techkeyy/justfair#readme"
}
